<?xml version="1.0" encoding="UTF-8"?>
<!--
  Biblioteca UNAMAD - configuracion de IIS. Equivalente al .htaccess de Apache.
  Este archivo vive en public/, que es la raiz fisica del sitio en IIS.
  Adaptado de la configuracion de PORTAL_UNAMAD. Diferencia importante: esta
  aplicacion NO emite cabeceras de seguridad por middleware (bootstrap/app.php
  solo registra permisos, visitas y el filtro de lectores), por lo que aqui SI
  se declaran.
-->
<configuration>
  <system.webServer>

    <directoryBrowse enabled="false" />
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- 1) Canonico: solo el dominio va a HTTPS. El acceso de pruebas por IP
             no se redirige, porque la condicion exige que la cabecera Host sea
             exactamente biblioteca.unamad.edu.pe -->
        <rule name="Canonico HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^biblioteca\.unamad\.edu\.pe$" />
          </conditions>
          <action type="Redirect" url="https://biblioteca.unamad.edu.pe/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) Quitar barra final salvo en directorios reales -->
        <rule name="Quitar barra final" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>

        <!-- 3) Front controller de Laravel -->
        <rule name="Front controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>

      <outboundRules>
        <rule name="Quitar X-Powered-By">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
        <!-- HSTS: descomentar cuando HTTPS lleve dias funcionando sin incidencias.
             Una vez enviado, los navegadores lo recuerdan y no hay vuelta atras facil.
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- 64 MB: el sistema importa padrones en Excel y sube PDF/portadas -->
        <!-- DataTables envia columnas y filtros por GET (libros supera 2400 bytes). -->
        <requestLimits maxAllowedContentLength="67108864" maxQueryString="8192" maxUrl="16384" />
        <!-- OJO: aqui NO va "storage". La raiz del sitio es public/, asi que la
             carpeta storage/ de Laravel ya queda fuera del alcance del navegador.
             Lo unico llamado "storage" accesible por URL es public/storage, el
             enlace que sirve las imagenes subidas (portadas, fotos de personas).
             Bloquearlo las rompe. Los demas segmentos estan igualmente fuera de
             la raiz: se dejan solo como defensa extra por si alguien reapunta el
             sitio a la raiz del proyecto. -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="vendor" />
          <add segment="node_modules" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" /><mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" /><mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mjs" /><mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>

  <!-- Assets con hash de Vite: cache de un ano, inmutable -->
  <location path="build">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Estaticos versionados a mano (img, css, js, lib): un ano -->
  <location path="img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="lib">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Imagenes subidas (portadas, fotos de personas). Laravel les pone nombre
       aleatorio al guardarlas, asi que una URL dada nunca cambia de contenido. -->
  <location path="storage">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
